<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>

<GridPane xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.wikimedievalsenac.Controllers.LoginController">
    <TextField fx:id="emailField" promptText="Email" GridPane.rowIndex="0" GridPane.columnIndex="0" GridPane.columnSpan="2"/>
    <PasswordField fx:id="senhaField" promptText="Senha" GridPane.rowIndex="1" GridPane.columnIndex="0" GridPane.columnSpan="2"/>
    <Button text="Login" onAction="#handleLogin" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
    <Button text="Registrar" onAction="#handleRegister" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
</GridPane>

