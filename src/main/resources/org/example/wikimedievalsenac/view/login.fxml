<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>

<GridPane fx:id="login" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/22" fx:controller="org.example.wikimedievalsenac.Controllers.LoginController">
    <TextField fx:id="emailField" promptText="Email" GridPane.columnSpan="2" />
    <PasswordField fx:id="senhaField" promptText="Senha" GridPane.columnSpan="2" GridPane.rowIndex="1" />
    <Button onAction="#handlebuttonLogin" text="Login" GridPane.rowIndex="2" />
    <Button onAction="#handlebuttonRegister" text="Registrar" GridPane.columnIndex="1" GridPane.rowIndex="2" />
   <columnConstraints>
      <ColumnConstraints />
      <ColumnConstraints />
   </columnConstraints>
   <rowConstraints>
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
   </rowConstraints>
</GridPane>
